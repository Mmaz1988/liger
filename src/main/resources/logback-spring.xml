<?xml version="1.0" encoding="UTF-8"?>

<configuration scan="true">
    <include resource="org/springframework/boot/logging/logback/base.xml"/>

    <!-- Raise with LIGER_LOG_LEVEL=DEBUG (env var or -D) for per-rule detail;
         no edit to this file needed. -->
    <logger name="de.ukon.liger" level="${LIGER_LOG_LEVEL:-INFO}"/>

    <logger name="javax.activation" level="WARN"/>
    <logger name="javax.mail" level="WARN"/>
    <logger name="javax.xml.bind" level="WARN"/>
    <logger name="ch.qos.logback" level="WARN"/>
    <logger name="com.codahale.metrics" level="WARN"/>
    <logger name="com.ryantenney" level="WARN"/>
    <logger name="com.sun.xml.internal.bind" level="WARN"/>
    <logger name="com.zaxxer" level="WARN"/>
    <logger name="io.undertow" level="WARN"/>
    <logger name="org.apache" level="WARN"/>
    <logger name="org.apache.catalina.startup.DigesterFactory" level="OFF"/>
    <logger name="org.bson" level="WARN"/>
    <logger name="org.hibernate.validator" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.hibernate.ejb.HibernatePersistence" level="OFF"/>
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.springframework.web" level="WARN"/>
    <logger name="org.springframework.security" level="WARN"/>
    <logger name="org.springframework.cache" level="WARN"/>
    <logger name="org.springframework.messaging" level="WARN"/>
    <logger name="org.springframework.security.web.FilterChainProxy" level="INFO"/>
    <logger name="javax.management" level="WARN"/>
    <logger name="javax.management.remote.rmi" level="INFO"/>
    <logger name="org.springframework.jndi" level="INFO"/>
    <logger name="jdk.event.security" level="WARN" />
    <logger name="org.springframework.web.servlet.handler.AbstractHandlerExceptionResolver" level="OFF"/>
    <logger name="org.springframework.web.servlet.mvc.method.annotation.ExceptionHandlerExceptionResolver" level="OFF"/>

    <contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
        <resetJUL>true</resetJUL>
    </contextListener>

    <!-- The base.xml include above already attaches a rolling FILE appender to
         root, so a per-run log needs no extra appender here — only a path:
           java -jar jars/liger.jar -web \
                --logging.file.name=logs/liger-$(date +%Y%m%d-%H%M%S).log
         Without that argument FILE still writes, to logback's default
         ${java.io.tmpdir}/spring.log (rolled daily, 7 days kept). Detaching it
         when no path is given would need a logback <if>, i.e. janino on the
         classpath; at root INFO the untargeted file is small enough not to
         justify the dependency. Listing CONSOLE below re-uses base.xml's
         appender instance rather than adding a second one, so console lines
         are not duplicated. -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
